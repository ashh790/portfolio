# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# SMTP credentials used by app/api/contact/route.ts to send contact-form submissions.
# For Gmail: enable 2-Step Verification on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that (not the normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional: where contact-form messages are delivered. Defaults to profile.email
# (app/data/profile.ts) if not set.
CONTACT_TO_EMAIL=dalalashraf456@gmail.com

# Used by metadataBase and the canonical URL in app/layout.tsx. Set this to the
# site's real deployed URL in production. (public/robots.txt and public/sitemap.xml
# are static files on this Next.js version and need their placeholder domain
# updated separately — see README.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
